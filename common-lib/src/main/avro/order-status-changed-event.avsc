{
  "type": "record",
  "name": "OrderStatusChangedEvent",
  "namespace": "com.ecommerce.common.event",
  "doc": "Событие изменения статуса заказа в order-service",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Уникальный ID события (UUID) для идемпотентности"
    },
    {
      "name": "orderId",
      "type": "string",
      "doc": "Уникальный идентификатор заказа (UUID)"
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "Идентификатор пользователя (UUID)"
    },
    {
      "name": "oldStatus",
      "type": "string",
      "doc": "Предыдущий статус заказа"
    },
    {
      "name": "newStatus",
      "type": "string",
      "doc": "Новый статус заказа (PAID, CANCELLED, COMPLETED и др)"
    },
    {
      "name": "reason",
      "type": ["null", "string"],
      "default": null,
      "doc": "Причина изменения статуса"
    },
    {
      "name": "updatedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Временная метка изменения статуса"
    }
  ]
}